<?php

/**
 * @file
 * Install, update and uninstall functions for neo_seo.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Sql\SqlContentEntityStorage;
use Drupal\neo_seo\SeoOverrides;
use Drupal\neo_seo\SiteIdentity\IdentitySources;

/**
 * Implements hook_install().
 *
 * Turns on the SEO display extender, so Views pages get their SEO settings,
 * and takes the logo and social profiles from the favicon and site settings
 * where those modules have them.
 */
function neo_seo_install(bool $is_syncing = FALSE): void {
  _neo_seo_views_display_extender(TRUE);
  if (!$is_syncing) {
    _neo_seo_identity_sources()->adoptInConfig();
  }
}

/**
 * Takes the logo and social profiles from the favicon and site settings.
 *
 * Only where neo_seo has nothing of its own: a logo from the favicon when no
 * media logo is chosen, and the site settings' social links when the typed
 * list is empty or holds nothing site settings does not (it is then emptied).
 */
function neo_seo_update_11001(): string {
  $config = \Drupal::configFactory()->getEditable('neo_seo.settings');
  $before = (array) $config->get('identity');
  _neo_seo_identity_sources()->adoptInConfig();
  $after = (array) \Drupal::configFactory()->get('neo_seo.settings')->get('identity');
  $changes = [];
  if (($after['logo_source'] ?? 'media') === 'favicon' && ($before['logo_source'] ?? 'media') !== 'favicon') {
    $changes[] = t('the logo now comes from the favicon');
  }
  if (!empty($after['same_as_site_settings']) && empty($before['same_as_site_settings'])) {
    $changes[] = t('the social profiles now come from site settings');
  }
  return $changes ? (string) t('Site identity: @changes.', ['@changes' => implode('; ', $changes)]) : (string) t('Site identity unchanged.');
}

/**
 * Publishes the site's schema at /schemamap.xml.
 *
 * On by default, as on a new site; the SEO settings turn it off.
 */
function neo_seo_update_11002(): string {
  $config = \Drupal::configFactory()->getEditable('neo_seo.settings');
  if ($config->get('schemamap') === NULL) {
    $config->set('schemamap', TRUE)->save();
  }
  return (string) t("The site's schema is published at /schemamap.xml. The SEO settings turn it off.");
}

/**
 * Adds the title separator and the snippet variables.
 *
 * The separator is "|", as titles have it now. The global title template
 * takes the separator token only while it is still the one shipped: an edited
 * template is left alone, and so is every page's own title.
 */
function neo_seo_update_11003(): string {
  $config = \Drupal::configFactory()->getEditable('neo_seo.settings');
  if ($config->get('separator') === NULL) {
    $config->set('separator', '|');
  }
  if ($config->get('variables') === NULL) {
    $config->set('variables', [
      ['label' => 'Title', 'token' => '[neo:title]'],
      ['label' => 'Site title', 'token' => '[site:name]'],
      ['label' => 'Separator', 'token' => '[neo-seo:separator]'],
      ['label' => 'Description', 'token' => '[neo:description]'],
      ['label' => 'Tagline', 'token' => '[site:slogan]'],
    ]);
  }
  $config->save();
  $global = \Drupal::configFactory()->getEditable('neo_seo.defaults.global');
  if ($global->get('values.title') === '[neo:title] | [site:name]') {
    $global->set('values.title', '[neo:title] [neo-seo:separator] [site:name]')->save();
    return (string) t('Title separator added; the global title template now uses it.');
  }
  return (string) t('Title separator added. The global title template was edited, so it was left alone.');
}

/**
 * Adds the URL slug to the SEO overrides.
 *
 * The field already holds data, which the entity definition update manager
 * refuses to change, so the column is added to each of its tables by hand and
 * the installed schema and definition are brought in line with it.
 */
function neo_seo_update_11004(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  $entityTypeManager = \Drupal::entityTypeManager();
  $schema = \Drupal::database()->schema();
  $storageSchema = \Drupal::keyValue('entity.storage_schema.sql');
  $spec = ['type' => 'varchar', 'length' => 255, 'not null' => FALSE];
  $updated = [];
  foreach ($entityTypeManager->getDefinitions() as $entityTypeId => $entityType) {
    $installed = $updateManager->getFieldStorageDefinition(SeoOverrides::FIELD, $entityTypeId);
    $storage = $entityTypeManager->getStorage($entityTypeId);
    if (!$installed || $installed->getProvider() !== 'neo_seo' || !$storage instanceof SqlContentEntityStorage) {
      continue;
    }
    $definition = SeoOverrides::definition($entityType->isRevisionable())
      ->setName(SeoOverrides::FIELD)
      ->setTargetEntityTypeId($entityTypeId)
      ->setProvider('neo_seo');
    $mapping = $storage->getTableMapping([SeoOverrides::FIELD => $definition]);
    $column = $mapping->getFieldColumnName($definition, 'slug');
    $key = $entityTypeId . '.field_schema_data.' . SeoOverrides::FIELD;
    $tables = (array) $storageSchema->get($key, []);
    foreach ($mapping->getAllFieldTableNames(SeoOverrides::FIELD) as $table) {
      if (!$schema->fieldExists($table, $column)) {
        $schema->addField($table, $column, $spec);
      }
      if (isset($tables[$table])) {
        $tables[$table]['fields'][$column] = $spec;
      }
    }
    $storageSchema->set($key, $tables);
    \Drupal::service('entity.last_installed_schema.repository')->setLastInstalledFieldStorageDefinition($definition);
    $updated[] = $entityTypeId;
  }
  return $updated
    ? (string) t('URL slug added to the SEO overrides of: @types.', ['@types' => implode(', ', $updated)])
    : (string) t('No entity type has SEO overrides; nothing to add.');
}

/**
 * The identity sources, built here rather than taken from the container.
 *
 * An update runs before the container knows a service added in the same
 * release.
 */
function _neo_seo_identity_sources(): IdentitySources {
  return new IdentitySources(
    \Drupal::moduleHandler(),
    \Drupal::entityTypeManager(),
    \Drupal::service('entity_display.repository'),
    \Drupal::service('entity_field.manager'),
    \Drupal::service('file_url_generator'),
    \Drupal::configFactory(),
    \Drupal::hasService('neo_favicon.manager') ? \Drupal::service('neo_favicon.manager') : NULL,
  );
}

/**
 * Implements hook_uninstall().
 */
function neo_seo_uninstall(): void {
  _neo_seo_views_display_extender(FALSE);
}

/**
 * Adds or removes the SEO display extender from the enabled extenders.
 *
 * @param bool $enable
 *   TRUE to enable it, FALSE to remove it.
 */
function _neo_seo_views_display_extender(bool $enable): void {
  if (!\Drupal::moduleHandler()->moduleExists('views')) {
    return;
  }
  $config = \Drupal::configFactory()->getEditable('views.settings');
  $extenders = (array) $config->get('display_extenders');
  $extenders = array_values(array_diff($extenders, ['neo_seo']));
  if ($enable) {
    $extenders[] = 'neo_seo';
  }
  $config->set('display_extenders', $extenders)->save();
}
